{
  "name": "agentic-leash",
  "productName": "Agentic Leash",
  "author": "Velu Gautam",
  "license": "MIT",
  "version": "0.4.0",
  "private": true,
  "description": "See and control what AI coding agents can touch on your Mac",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && APPLE_KEYCHAIN_PROFILE=agentic-leash env -u APPLE_ID -u APPLE_APP_SPECIFIC_PASSWORD -u APPLE_TEAM_ID electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:all": "electron-vite build && APPLE_KEYCHAIN_PROFILE=agentic-leash env -u APPLE_ID -u APPLE_APP_SPECIFIC_PASSWORD -u APPLE_TEAM_ID electron-builder --mac --win --linux",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.44",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.11",
    "electron-vite": "^6.0.0",
    "lucide-react": "0.564.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.2",
    "@tanstack/react-virtual": "^3.14.19",
    "diff": "9.0.0"
  }
}
